FRONTEND_URL=http://localhost:5500
DATABASE_PATH=./data/investigator.db
ENABLE_LOCAL_AI=false
OLLAMA_URL=http://localhost:11434

REQUIRE_AI_VERIFICATION=true
# true  -> a verifier outage completes the case with a "not reviewed" banner
# false -> a verifier outage fails the whole investigation (original behaviour)
AI_DEGRADE_GRACEFULLY=true
AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=

# Leave HUGGINGFACE_MODEL empty and the app asks the router which models are
# live for your token, then picks the cheapest working one. Pin a repo id
# ("Qwen/Qwen2.5-7B-Instruct") or an exact pair ("Qwen/Qwen3-8B:novita") only
# if you want to force a specific choice. Run `python scripts/check_ai.py` to
# see what your token can actually reach right now.
HUGGINGFACE_MODEL=
HUGGINGFACE_MODEL_FALLBACKS=
# "auto" lets Hugging Face choose the downstream provider. Pin a slug such as
# together, novita, nebius, or fireworks-ai only to override that.
HUGGINGFACE_PROVIDER=auto
HUGGINGFACE_DISCOVER_MODELS=true
HUGGINGFACE_CATALOG_TTL=900
HUGGINGFACE_MAX_ATTEMPTS=8
HUGGINGFACE_TIMEOUT=35

MAX_QUERIES=30
MAX_URLS=120
MAX_DOCUMENTS=30
MAX_ENTITIES=40
