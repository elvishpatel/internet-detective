FRONTEND_URL=http://localhost:5500
DATABASE_PATH=./data/investigator.db
ENABLE_LOCAL_AI=false
OLLAMA_URL=http://localhost:11434
REQUIRE_AI_VERIFICATION=true
AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
# Pin the router to a serverless provider (novita/nebius serve Qwen2.5 serverless).
# If the pinned provider lacks the model, the router falls back to a dedicated-only endpoint and 400s.
HUGGINGFACE_PROVIDER=novita
MAX_QUERIES=30
MAX_URLS=120
MAX_DOCUMENTS=30
MAX_ENTITIES=40
